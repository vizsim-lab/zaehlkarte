        {
          "@id": "https://www.offenesdatenportal.de/dataset/d487b8fc-480f-42bc-a4f1-b075ccdb1546/resource/81e34600-37fd-42d7-bbc5-f268bc49f03a"
        },
        {
          "@id": "https://www.offenesdatenportal.de/dataset/d487b8fc-480f-42bc-a4f1-b075ccdb1546/resource/46dbe24a-e8ce-4e76-9592-c853779fbd64"
